#include <stdio.h>

char operation;

int add(int a, int b);
int subtract(int a, int b);
int multiply(int a, int b);
int divide(int a, int b);
int calculate(int a, int b, char operation);


int main() {
    scanf("%d %d %c", &a, &b, &operation)

    calculate(a,b,operation);

    return 0;
}

calculate(int a, int b, char operation){
    if (operation == '+') {
    add(a,b);
} else if (operation == '-') {
    subtract(a, b);
} else if (operation == '*') {
    multiply(a, b);
} else if (operation == '/') {
    divide(a, b);
} else if (operation == 'q') {
    return 0;
} else {
    printf("Invalid input");
    return 0;
}
}
